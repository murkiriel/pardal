# Dependências diretas do gerador, nas versões testadas (build completo e testes, Python 3.12).
# O requirements.txt é gerado a partir deste arquivo, com todas as dependências (inclusive as
# transitivas) fixadas e com hash; não edite o .txt à mão. Depois de mudar este arquivo, da pasta
# gerador/:
#   uv pip compile requirements.in --generate-hashes --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu -o requirements.txt
#   uv pip compile requirements-dev.in --generate-hashes --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu -o requirements-dev.txt
# Ao atualizar alguma versão, rode os testes e um build de um estado antes de publicar.
requests==2.32.5
osmium==4.3.1      # pyosmium: filtro do extrato .pbf da Geofabrik (dispensa o binário osmium)
openpyxl==3.1.5    # leitura dos XLSX do DNIT / Artesp / DER-SP
shapely==2.1.2     # UF de cada ponto pelo polígono do IBGE (opcional — sem ele, recorte por bbox)
numpy==2.4.2       # deduplicação do arquivo do Brasil sem carregar as linhas (e dependência do shapely)
pyshp==3.1.6       # shapefiles do SNV (DNIT)
pypdf==6.14.2      # lista de radares do Rio (PDF)
zstandard==0.25.0  # compacta o SQLite de cada estado para a release (.sqlite.zst)
